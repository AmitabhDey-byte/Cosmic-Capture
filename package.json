{
  "name": "cosmic-capture-zerotrace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api": "python -m backend.run",
    "db:migrate": "python -m backend.scripts.migrate",
    "dev:full": "concurrently \"npm run dev\" \"npm run api\"",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "contracts:format": "cargo fmt --manifest-path contracts/stellar-arena/Cargo.toml -- --check",
    "contracts:test": "cargo test --manifest-path contracts/stellar-arena/Cargo.toml",
    "contracts:build": "cargo build --manifest-path contracts/stellar-arena/Cargo.toml --target wasm32v1-none --release",
    "preview": "vite preview"
  },
  "dependencies": {
    "@albedo-link/intent": "^0.13.0",
    "@google/model-viewer": "^4.3.1",
    "@sentry/react": "^10.67.0",
    "@stellar/freighter-api": "^6.0.1",
    "@stellar/stellar-sdk": "^16.1.0",
    "chess.js": "^1.4.0",
    "concurrently": "^9.2.4",
    "lucide-react": "^1.26.0",
    "posthog-js": "^1.407.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
